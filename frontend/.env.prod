# ============================================
# DJ JOSEP FRONTEND - CONFIGURACIÓN DE PRODUCCIÓN
# ============================================
# ✅ Configuración optimizada para uso del DJ

# ===== CONFIGURACIÓN BÁSICA =====
NODE_ENV=production

# ===== API BACKEND =====
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MUSICSETS_PATH=/api/sets
NEXT_PUBLIC_ASSETS_BASE=http://localhost:4000

# ===== APLICACIÓN =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ===== BASE DE DATOS (referencia para backend) =====
DB_HOST=192.168.1.40
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=josepe_DB

# ===== EMAIL (referencia para backend) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui
CONTACT_EMAIL=admin@djjosepe.com

# ===== SOUNDCLOUD =====
# Para obtener un Client ID: https://developers.soundcloud.com/
NEXT_PUBLIC_SOUNDCLOUD_CLIENT_ID=

# ===== PRODUCCIÓN =====
CUSTOM_KEY=production-key-dj
NEXT_PUBLIC_DEBUG=false