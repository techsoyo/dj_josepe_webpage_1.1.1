# ===========================================
# DJ JOSEP BACKEND - CONFIGURACIÓN DE DESARROLLO
# ===========================================
# ✅ Configuración para desarrollo local

# ===== CONFIGURACIÓN BÁSICA =====
NODE_ENV=development
PORT=4000

# ===== BASE DE DATOS =====
# SQLite para desarrollo (más fácil)
DATABASE_URL="file:./src/db/database.sqlite"
# Configuración MySQL alternativa (comentada)
# DATABASE_URL="mysql://admin:admin123@192.168.1.40:3306/josepe_DB"
# DB_HOST=192.168.1.40
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=admin123
# DB_NAME=josepe_DB
# DB_CONNECTION_LIMIT=10

# ===== SEGURIDAD =====
JWT_SECRET=abc123def456ghi789jkl012mno345pqr678stu901vwx234yzab567cdef890ghij123klmn456opqr789stuv012wxyz345abcd678efgh901ijkl234mnop567qrst890uvwx123yzab456cdef789ghij012klmn345opqr678

# Rate Limiting (más permisivo para desarrollo)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000

# ===== URLS =====
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ===== EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui
SMTP_FROM="DJ Josep Website <noreply@djjosep.com>"
CONTACT_EMAIL=admin@djjosep.com

# ===== ARCHIVOS =====
MAX_FILE_SIZE=10
UPLOAD_DIR=./uploads

# ===== SITIO =====
SITE_NAME="DJ Josep"
SITE_DESCRIPTION="Sitio web oficial de DJ Josep"

# ===== CONFIGURACIÓN DE DESARROLLO =====
ENABLE_LOGGING=true
ANALYTICS_RETENTION_DAYS=90
ENABLE_COMPRESSION=true
STATIC_CACHE_MAX_AGE=86400
HEALTH_CHECK_SECRET=development_health_check_secret_123
DEBUG=true
VERBOSE_LOGGING=true